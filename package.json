{
  "name": "swallow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "원문 읽기부터 회상과 복습까지 이끄는 개인 학습 앱",
  "main": "dist-electron/electron/main.js",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "test": "vitest run",
    "build": "npm run build:pdf && npm run typecheck && vite build && tsc -p tsconfig.electron.json && node scripts/build-preload.mjs",
    "start": "npm run build && electron .",
    "dev": "node scripts/dev.mjs",
    "preview": "vite --host 127.0.0.1",
    "check": "npm run test && npm run build",
    "build:pdf": "node scripts/build-pdf-helper.mjs",
    "test:pdf-ui": "node scripts/test-pdf-ui.mjs",
    "source:check": "node scripts/prepare-public-source.mjs --check",
    "source:prepare": "node scripts/prepare-public-source.mjs"
  },
  "dependencies": {
    "ipaddr.js": "2.5.0",
    "linkedom": "0.18.13",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "^25.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "electron": "44.7.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "4.1.11"
  },
  "license": "MIT"
}
